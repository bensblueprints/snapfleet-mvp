# Snapfleet configuration — copy to .env or set in your environment.

# Port the server listens on
PORT=5322

# Admin UI password (CHANGE THIS on a public server!)
ADMIN_PASSWORD=admin

# SQLite database file
DB_PATH=./data/snapfleet.db

# Where rendered screenshots are stored
SHOTS_DIR=./data/shots

# Default cache lifetime for rendered screenshots (seconds)
DEFAULT_TTL_SECONDS=86400

# Concurrent Puppeteer pages (requests beyond this queue, 30s job timeout)
MAX_CONCURRENT=2

# Allow screenshotting localhost / private-network targets.
# Default true — self-hosters often shoot internal dashboards.
# Set to false for SSRF hygiene on multi-tenant / public deployments.
ALLOW_PRIVATE=true

# Optional: use a system Chrome/Chromium instead of the puppeteer-managed one
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: extra Chromium flags (Docker usually needs --no-sandbox)
# PUPPETEER_ARGS=--no-sandbox
